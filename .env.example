# ============================================================
# 92-Account-Center — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=account_center
# Database SSL mode: disable (dev), require (staging), verify-full (production)
DB_SSLMODE=disable

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT Secrets (REQUIRED: change in production!) ---
JWT_ACCESS_SECRET=dev-access-secret-CHANGE-ME
JWT_REFRESH_SECRET=dev-refresh-secret-CHANGE-ME
JWT_SECRET=dev-jwt-secret-CHANGE-ME

# --- Internal API Auth (REQUIRED for inter-service calls) ---
INTERNAL_API_TOKEN=

# --- Service URLs ---
CONFIG_SERVICE_URL=http://config-service:30315
AUTH_SERVICE_URL=http://auth-service:30302
ACCOUNT_SERVICE_URL=http://account-service:30301
CREDIT_SERVICE_URL=http://credit-service:30312
COMPLIANCE_SERVICE_URL=http://compliance-service:30313
NOTIFICATION_SERVICE_URL=http://notification-service:30311
DATA_PRODUCT_SERVICE_URL=http://data-product-service:30314
SMS_SERVICE_URL=http://notification-service:30311

# --- Notification: SMS Provider (optional) ---
# ALIYUN (default)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SIGN_NAME=
# TENCENT
TENCENT_APP_ID=
TENCENT_APP_SECRET=
TENCENT_SIGN_NAME=
# CHINATELECOM
CHINATELECOM_APP_ID=
CHINATELECOM_APP_SECRET=
CHINATELECOM_SIGN_NAME=

# --- Notification: Email Provider (optional) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SendGrid (alternative)
SENDGRID_API_KEY=
# AWS SES (alternative)
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- Notification: Push Provider (optional) ---
PUSH_MODE=sandbox
# APNs (Apple Push Notification service)
APNS_ENDPOINT=
APNS_BUNDLE_ID=
APNS_ACCESS_TOKEN=
# FCM (Firebase Cloud Messaging)
FCM_ENDPOINT=
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
# HMS (Huawei Mobile Services)
HMS_ENDPOINT=
HMS_APP_ID=
HMS_ACCESS_TOKEN=

# --- Notification: WeChat Template ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TPL_SUBSCRIPTION_EXPIRING=
WECHAT_TPL_PAYMENT_SUCCESS=
WECHAT_TPL_REFERRAL_BONUS=
WECHAT_TPL_TIER_UPGRADE=

# --- Notification: Other ---
FROM_ADDRESS=noreply@accountcenter.com
JWT_SECRET_NOTIFICATION=your-secret-key-change-in-production

# --- Auth Service: OAuth ---
OAUTH_REDIRECT_URI=http://localhost:30317/oauth/callback
WECHAT_APP_ID=
WECHAT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- Auth Service: Enterprise OAuth ---
WORK_WECHAT_CORP_ID=
WORK_WECHAT_AGENT_ID=
WORK_WECHAT_CORP_SECRET=
ENTERPRISE_OAUTH_REDIRECT_URI=http://localhost:30317/oauth/callback
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# --- Payment Service ---
PAYMENT_MODE=sandbox
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:30316/api/v1/payment/callback/alipay

# --- Data Product Service ---
READ_REPLICA_URL=

# --- Monitoring ---
VICTORIAMETRICS_URL=http://victoriametrics:8428
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=admin
