# ============================================================
# 92-Account-Center — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=account_center

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- JWT Secrets (REQUIRED: change in production!) ---
JWT_ACCESS_SECRET=dev-access-secret-CHANGE-ME
JWT_REFRESH_SECRET=dev-refresh-secret-CHANGE-ME
JWT_SECRET=dev-jwt-secret-CHANGE-ME

# --- Service URLs ---
CONFIG_SERVICE_URL=http://config-service:30315
AUTH_SERVICE_URL=http://auth-service:30302
ACCOUNT_SERVICE_URL=http://account-service:30301
CREDIT_SERVICE_URL=http://credit-service:30312
COMPLIANCE_SERVICE_URL=http://compliance-service:30313
NOTIFICATION_SERVICE_URL=http://notification-service:30311
DATA_PRODUCT_SERVICE_URL=http://data-product-service:30314
SMS_SERVICE_URL=http://notification-service:30311

# --- Notification: SMS Provider (optional) ---
# ALIYUN (default)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SIGN_NAME=
# TENCENT
TENCENT_APP_ID=
TENCENT_APP_SECRET=
TENCENT_SIGN_NAME=
# CHINATELECOM
CHINATELECOM_APP_ID=
CHINATELECOM_APP_SECRET=
CHINATELECOM_SIGN_NAME=

# --- Notification: Email Provider (optional) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SendGrid (alternative)
SENDGRID_API_KEY=
# AWS SES (alternative)
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- Notification: Other ---
FROM_ADDRESS=noreply@accountcenter.com
JWT_SECRET_NOTIFICATION=your-secret-key-change-in-production

# --- Monitoring ---
VICTORIAMETRICS_URL=http://victoriametrics:8428
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
