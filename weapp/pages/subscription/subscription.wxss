.sub-container { padding-bottom: var(--spacing-xl); }
.plan-header { display: flex; justify-content: space-between; align-items: center; }
.plan-name { font-size: var(--font-xl); font-weight: 700; color: var(--text-primary); }
.plan-status { font-size: var(--font-xs); padding: 4rpx 16rpx; border-radius: 20rpx; }
.plan-status.active { background: rgba(46, 213, 115, 0.15); color: var(--color-success); }
.plan-status.expired { background: rgba(255, 71, 87, 0.15); color: var(--color-danger); }
.plan-status.cancelled { background: rgba(139, 148, 158, 0.15); color: var(--text-muted); }
.plan-dates { margin-top: var(--spacing-sm); font-size: var(--font-sm); color: var(--text-secondary); }
.plan-dates text { display: block; }
.tier-name { font-size: var(--font-xxl); font-weight: 700; color: var(--brand-primary); }
.benefits { margin-top: var(--spacing-sm); }
.benefit { font-size: var(--font-sm); color: var(--text-secondary); margin-top: var(--spacing-xs); display: block; }
