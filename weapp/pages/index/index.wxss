.home-container { min-height: 100vh; }
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: var(--spacing-xl);
}
.welcome-title {
  font-size: 64rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #6C63FF, #00D4FF);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.welcome-desc { font-size: var(--font-base); color: var(--text-secondary); margin-top: var(--spacing-sm); }
.login-btn {
  margin-top: var(--spacing-xl);
  background: linear-gradient(135deg, #6C63FF, #00D4FF);
  border-radius: var(--button-radius);
  padding: 24rpx 80rpx;
  color: #fff;
  font-weight: 600;
}
.rfm-hero {
  background: linear-gradient(135deg, #1C2333 0%, #242D3D 100%);
  margin: var(--spacing-md);
  border-radius: var(--card-radius);
  padding: var(--spacing-lg);
  text-align: center;
  border: 1rpx solid var(--border-color);
}
.rfm-score { font-size: 96rpx; font-weight: 700; color: var(--brand-primary); }
.rfm-label { display: block; font-size: var(--font-sm); color: var(--text-secondary); }
.rfm-segment {
  display: inline-block;
  margin-top: var(--spacing-sm);
  padding: 8rpx 24rpx;
  background: rgba(108, 99, 255, 0.15);
  border-radius: 40rpx;
  font-size: var(--font-sm);
  color: var(--brand-primary);
}
.rfm-details { display: flex; justify-content: space-around; margin-top: var(--spacing-lg); }
.rfm-item { text-align: center; }
.rfm-item .val { font-size: var(--font-xxl); font-weight: 700; color: var(--text-primary); display: block; }
.rfm-item .lbl { font-size: var(--font-xs); color: var(--text-secondary); margin-top: 4rpx; }
.quick-actions { display: flex; justify-content: space-around; padding: var(--spacing-md); }
.action-card {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: var(--spacing-md);
  width: 28%;
  text-align: center;
  border: 1rpx solid var(--border-color);
}
.action-icon { font-size: 48rpx; display: block; }
.action-name { font-size: var(--font-sm); color: var(--text-primary); margin-top: var(--spacing-xs); }
