.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--card-radius);
  text-align: center;
}
.empty-state-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}
.empty-state-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}
.empty-state-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  max-width: 640rpx;
  line-height: 1.5;
  margin-bottom: 48rpx;
}
.empty-state-action {
  background: linear-gradient(135deg, var(--brand-primary), var(--brand-secondary));
  border-radius: 16rpx;
  padding: 20rpx 64rpx;
}
.empty-state-action-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
