{
  "pages": [
    "pages/index/index",
    "pages/login/login",
    "pages/register/register"
  ],
  "subPackages": [
    {
      "root": "packageCredits",
      "name": "credits",
      "pages": [
        "pages/credits/credits",
        "pages/credits/history/history",
        "pages/credits/transfer/transfer"
      ]
    },
    {
      "root": "packageSubscription",
      "name": "subscription",
      "pages": [
        "pages/subscription/subscription",
        "pages/subscription/detail/detail"
      ]
    },
    {
      "root": "packageSecurity",
      "name": "security",
      "pages": [
        "pages/security/security",
        "pages/security/devices/devices",
        "pages/security/2fa/2fa"
      ]
    },
    {
      "root": "packageHelp",
      "name": "help",
      "pages": [
        "pages/faq/faq",
        "pages/help/help",
        "pages/about/about"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["credits", "subscription"]
    },
    "pages/login/login": {
      "network": "all",
      "packages": ["security"]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "#0D1117",
    "navigationBarTitleText": "Account Center",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#0D1117",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#8B949E",
    "selectedColor": "#6C63FF",
    "backgroundColor": "#161B22",
    "borderStyle": "black",
    "list": [
      { "pagePath": "pages/index/index", "iconPath": "styles/icons/home.png", "selectedIconPath": "styles/icons/home-active.png", "text": "首页" },
      { "pagePath": "packageCredits/pages/credits/credits", "iconPath": "styles/icons/credits.png", "selectedIconPath": "styles/icons/credits-active.png", "text": "积分" },
      { "pagePath": "packageSubscription/pages/subscription/subscription", "iconPath": "styles/icons/subscription.png", "selectedIconPath": "styles/icons/subscription-active.png", "text": "订阅" },
      { "pagePath": "packageSecurity/pages/security/security", "iconPath": "styles/icons/security.png", "selectedIconPath": "styles/icons/security-active.png", "text": "安全" },
      { "pagePath": "packageHelp/pages/about/about", "iconPath": "styles/icons/about.png", "selectedIconPath": "styles/icons/about-active.png", "text": "关于" }
    ]
  },
  "usingComponents": {
    "app-card": "/components/app-card/app-card",
    "gradient-button": "/components/gradient-button/gradient-button",
    "loading-overlay": "/components/loading-overlay/loading-overlay",
    "empty-state": "/components/empty-state/empty-state",
    "skeleton": "/components/skeleton/skeleton"
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json"
}
